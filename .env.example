# HoYoLABにログインしたブラウザから取得する。
# 最小構成は ltuid_v2 と ltoken_v2 の2つ。
HOYOLAB_COOKIE="ltuid_v2=YOUR_HOYOLAB_UID; ltoken_v2=YOUR_HOYOLAB_TOKEN"

# 通常は変更不要。空ならgenshin.pyと同じ固定User-Agentを使用する。
# HOYOLAB_USER_AGENT="Mozilla/5.0 ..."

# Cookie保存用の32バイト秘密鍵（64桁hex）。暗号学的乱数で生成し、Git管理しない。
# 未指定ではCookie保存APIは503。既存暗号文の再暗号化なしに変更しない。
# HOYOLAB_COOKIE_KEY="GENERATE_A_PRIVATE_64_HEX_CHARACTER_KEY"

# 初期管理者。serve起動時（またはbootstrap-admin引数なし）、users tableが空のときだけ使用。
# パスワードはローカルで設定する。変更済みユーザーのリセットには使用しない。
INITIAL_ADMIN_USERNAME="admin"
INITIAL_ADMIN_PASSWORD=""

# Dashboardバックエンド（HoYoLAB疎通確認だけなら不要）。
# DBは通常稼動環境で事前に用意する。DB_PASSWORDはローカルで設定する。
# DB_NAME/DB_USER/DB_PASSWORDを揃えて指定する。既存DATABASE_URLは互換入力として利用可能。
DB_HOST="127.0.0.1"
DB_PORT="5432"
DB_NAME="attos_dashboard"
DB_USER="attos_dashboard"
DB_PASSWORD=""
# ComposeのDB初期化管理者用。DB_PASSWORDと異なる値を設定する（appへは渡さない）。
DB_ADMIN_PASSWORD=""
# serveがAPIとDashboardを同じポートで公開する。Compose内では0.0.0.0:8080に上書き。
BIND_ADDR="127.0.0.1:8080"
# WebAuthnにはDNS名またはlocalhostを使う（IPリテラル不可）。
PUBLIC_ORIGIN="http://localhost:8080"
# 通常は未指定。既定値はPUBLIC_ORIGINのホスト名。
# RP_ID="localhost"
# 本番HTTPS公開時はPUBLIC_ORIGIN="https://agd.example.com"、RP_ID="agd.example.com"。
# PUBLIC_ORIGINに/apiを含めない。APIは同一Originの/api/v1/...で公開。
SESSION_TTL_DAYS="7"
TIMEZONE_OFFSET="+09:00"
# dx build --package attos-dashboard-ui --platform web --release のpublic出力。
DASHBOARD_UI_DIR="target/dx/attos-dashboard-ui/release/web/public"
