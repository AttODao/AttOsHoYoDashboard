# compose.yaml 用の設定。コピーして .env に保存し、chmod 600 .env を実行する。
# 秘密値はこのファイルやGitに書かない。

# PostgreSQL。DB名・ユーザー名・パスワードは初回の空ボリュームにだけ適用される。
DB_NAME="attos_dashboard"
DB_USER="attos_dashboard"
DB_PASSWORD=""
# PostgreSQL管理者専用。DB_PASSWORDとは異なる強固な値を設定する。
DB_ADMIN_PASSWORD=""

# 初期管理者。ユーザーが存在しないときだけ作成され、初回ログインで変更が必要。
# パスワードは12〜256 UTF-8バイト。既存ユーザーのリセットには使えない。
INITIAL_ADMIN_USERNAME="admin"
INITIAL_ADMIN_PASSWORD=""

# HoYoLAB Cookie暗号化用の秘密鍵。暗号学的乱数32バイトを64桁の16進数で指定する。
# DBと別に安全に保管し、保存済みCookieがある状態では変更しない。
HOYOLAB_COOKIE_KEY=""

# 実際の公開URLとドメインへ変更する。パス（/api等）は含めない。
PUBLIC_ORIGIN="https://agd.example.com"
RP_ID="agd.example.com"
# ローカル利用時は必ず両方を変更する：
# PUBLIC_ORIGIN="http://localhost:8080"
# RP_ID="localhost"

# セッションの固定有効日数（正の整数）。アクセスしても期限は延長されない。
SESSION_TTL_DAYS="7"
# 自動受け取り時刻に使う固定UTCオフセット。夏時間の自動調整はしない。
TIMEZONE_OFFSET="+09:00"

# DB接続先・コンテナ内待受・画面の配置先はCompose／イメージ側で設定済み。
# HoYoLABのCookieは .env ではなく、ログイン後の画面から登録する。
