# HoYoLABにログインしたブラウザから取得する。
# 最小構成は ltuid_v2 と ltoken_v2 の2つ。
HOYOLAB_COOKIE="ltuid_v2=YOUR_HOYOLAB_UID; ltoken_v2=YOUR_HOYOLAB_TOKEN"

# 通常は変更不要。空ならgenshin.pyと同じ固定User-Agentを使用する。
# HOYOLAB_USER_AGENT="Mozilla/5.0 ..."

# Cookie保存用の32バイト秘密鍵（64桁hex）。暗号学的乱数で生成し、Git管理しない。
# 未指定ではCookie保存APIは503。既存暗号文の再暗号化なしに変更しない。
# HOYOLAB_COOKIE_KEY="GENERATE_A_PRIVATE_64_HEX_CHARACTER_KEY"

# Dashboardバックエンド（HoYoLAB疎通確認だけなら不要）。
# 専用PostgreSQL DBの実値に置き換えて、DATABASE_URLのコメントを外す。
# DATABASE_URL="postgres://dashboard:CHANGE_ME@127.0.0.1:5432/dashboard"
BIND_ADDR="127.0.0.1:8080"
# WebAuthnにはDNS名またはlocalhostを使う（IPリテラル不可）。
PUBLIC_ORIGIN="http://localhost:8080"
# 通常は未指定。既定値はPUBLIC_ORIGINのホスト名。
# RP_ID="localhost"
SESSION_TTL_DAYS="7"
TIMEZONE_OFFSET="+09:00"
