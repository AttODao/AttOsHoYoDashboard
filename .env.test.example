# test-server reads .env.test, never the normal server's .env.
# Database address, loopback binding and public origin are fixed by devenv.
INITIAL_ADMIN_USERNAME="test-admin"
INITIAL_ADMIN_PASSWORD="public-test-only-password"
# Required: supply your own test-only 64-character hexadecimal key.
# Keep the same key while retaining the test DB. No automatic generation.
HOYOLAB_COOKIE_KEY=""
