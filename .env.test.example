# launch-server reads .env.test, never the normal server's .env.
# Database socket/port and HTTP loopback ports are isolated/fixed by devenv.
DB_NAME="attos_test"
DB_USER="attos_test"
# Public test-only credential: never reuse it for a normal/production DB.
DB_PASSWORD="public-test-database-password"
INITIAL_ADMIN_USERNAME="test-admin"
INITIAL_ADMIN_PASSWORD="public-test-only-password"
# Required: supply your own test-only 64-character hexadecimal key.
# Keep the same key while retaining the test DB. No automatic generation.
HOYOLAB_COOKIE_KEY=""
