<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- Star Rail widget text and rows (layout/ahd_widget_starrail.xml). -->
    <style name="AhdWidgetStarRailLabel">
        <item name="android:layout_width">wrap_content</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:ellipsize">end</item>
        <item name="android:includeFontPadding">false</item>
        <item name="android:maxLines">1</item>
        <item name="android:textColor">@color/ahd_widget_starrail_muted</item>
        <item name="android:textSize">@dimen/ahd_indicator_label_text</item>
    </style>
    <style name="AhdWidgetStarRailTime" parent="AhdWidgetStarRailLabel">
        <item name="android:fontFeatureSettings">tnum</item>
        <item name="android:textColor">@color/ahd_indicator_text</item>
        <item name="android:textSize">@dimen/ahd_indicator_bar_value_text</item>
        <item name="android:textStyle">bold</item>
        <item name="android:visibility">gone</item>
    </style>
    <style name="AhdWidgetStarRailTime.Warn">
        <item name="android:textColor">@color/ahd_indicator_full</item>
    </style>
    <style name="AhdWidgetStarRailSmall">
        <item name="android:layout_width">wrap_content</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:layout_marginTop">3dp</item>
        <item name="android:ellipsize">end</item>
        <item name="android:includeFontPadding">false</item>
        <item name="android:maxLines">1</item>
        <item name="android:fontFeatureSettings">tnum</item>
        <item name="android:textColor">@color/ahd_widget_starrail_muted</item>
        <item name="android:textSize">10sp</item>
        <item name="android:visibility">gone</item>
    </style>
    <style name="AhdWidgetStarRailSmall.Warn">
        <item name="android:textColor">@color/ahd_indicator_full</item>
    </style>
    <style name="AhdWidgetStarRailLine">
        <item name="android:layout_width">wrap_content</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:layout_marginTop">2dp</item>
        <item name="android:ellipsize">end</item>
        <item name="android:includeFontPadding">false</item>
        <item name="android:maxLines">1</item>
        <item name="android:fontFeatureSettings">tnum</item>
        <item name="android:textColor">@color/ahd_widget_starrail_muted</item>
        <item name="android:textSize">@dimen/ahd_indicator_caption_text</item>
        <item name="android:visibility">gone</item>
    </style>
    <style name="AhdWidgetStarRailLine.Warn">
        <item name="android:textColor">@color/ahd_indicator_full</item>
        <item name="android:textStyle">bold</item>
    </style>
    <style name="AhdWidgetStarRailRow">
        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:orientation">horizontal</item>
    </style>
    <style name="AhdWidgetStarRailRowIcon">
        <item name="android:layout_width">14dp</item>
        <item name="android:layout_height">14dp</item>
        <item name="android:layout_marginEnd">6dp</item>
        <item name="android:importantForAccessibility">no</item>
        <item name="android:tint">@color/ahd_indicator_starrail</item>
        <item name="android:tintMode">src_in</item>
    </style>
    <style name="AhdWidgetStarRailSlot">
        <item name="android:layout_width">0dp</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:layout_weight">1</item>
    </style>
</resources>
