<?xml version="1.0" encoding="utf-8"?>
<!-- Bar indicator (AhdIndicators.bar): label and value, the bar, an optional caption. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/ahd_indicator_root"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:importantForAccessibility="yes"
    android:orientation="vertical">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="bottom"
        android:importantForAccessibility="noHideDescendants"
        android:orientation="horizontal">

        <TextView
            android:id="@+id/ahd_indicator_label"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginEnd="6dp"
            android:layout_weight="1"
            android:ellipsize="end"
            android:includeFontPadding="false"
            android:maxLines="1"
            android:textColor="@color/ahd_indicator_muted"
            android:textSize="@dimen/ahd_indicator_label_text" />

        <TextView
            android:id="@+id/ahd_indicator_value"
            style="@style/AhdIndicatorValue"
            android:textSize="@dimen/ahd_indicator_bar_value_text" />

        <TextView
            android:id="@+id/ahd_indicator_value_full"
            style="@style/AhdIndicatorValue.Full"
            android:textSize="@dimen/ahd_indicator_bar_value_text" />
    </LinearLayout>

    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="@dimen/ahd_indicator_bar_height"
        android:layout_marginTop="4dp"
        android:importantForAccessibility="noHideDescendants">

        <ImageView
            android:id="@+id/ahd_indicator_track"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:importantForAccessibility="no"
            android:scaleType="fitXY"
            android:src="@drawable/ahd_indicator_bar_shape"
            android:tint="@color/ahd_indicator_track"
            android:tintMode="src_in" />

        <ImageView
            android:id="@+id/ahd_indicator_fill_genshin"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:importantForAccessibility="no"
            android:scaleType="fitXY"
            android:src="@drawable/ahd_indicator_bar_fill"
            android:tint="@color/ahd_indicator_genshin"
            android:tintMode="src_in"
            android:visibility="gone" />
        <ImageView
            android:id="@+id/ahd_indicator_fill_starrail"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:importantForAccessibility="no"
            android:scaleType="fitXY"
            android:src="@drawable/ahd_indicator_bar_fill"
            android:tint="@color/ahd_indicator_starrail"
            android:tintMode="src_in"
            android:visibility="gone" />
        <ImageView
            android:id="@+id/ahd_indicator_fill_near"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:importantForAccessibility="no"
            android:scaleType="fitXY"
            android:src="@drawable/ahd_indicator_bar_fill"
            android:tint="@color/ahd_indicator_near"
            android:tintMode="src_in"
            android:visibility="gone" />
        <ImageView
            android:id="@+id/ahd_indicator_fill_full"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:importantForAccessibility="no"
            android:scaleType="fitXY"
            android:src="@drawable/ahd_indicator_bar_fill"
            android:tint="@color/ahd_indicator_full"
            android:tintMode="src_in"
            android:visibility="gone" />
    </FrameLayout>

    <TextView
        android:id="@+id/ahd_indicator_caption"
        style="@style/AhdIndicatorCaption"
        android:layout_marginTop="3dp" />
</LinearLayout>
