<?xml version="1.0" encoding="utf-8"?>
<!-- A tile of the regular widgets (AhdIndicators.tile adds it through ahd_indicator_tile_<game>.xml,
     which sets the game's colors). A share (Realm Currency, daily training, Simulated Universe)
     is a 36dp arc around the icon with "value/max" and one detail beside it; a count has the
     icon before "value/max", pips under it and then the detail. The detail is hourglass + time
     left, the warning symbol + time or "上限", a status symbol with its word, the gift with
     the extra reward's status symbol, or a short name. Value, arc fill, detail symbol and
     detail text exist once per color and the code shows one; it also sets the text sizes
     (AhdIndicatorModel.fit) and centers a tile with an arc. Not read by itself: the widget
     root carries the description. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/ahd_indicator_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="horizontal">

    <FrameLayout
        android:id="@+id/ahd_indicator_ring"
        android:layout_width="@dimen/ahd_indicator_arc"
        android:layout_height="@dimen/ahd_indicator_arc"
        android:layout_marginEnd="6dp"
        android:visibility="gone">
        <ImageView
            style="@style/AhdArc.Track"
            android:src="@drawable/ahd_indicator_arc_track_36" />
        <ImageView
            android:id="@+id/ahd_indicator_fill_accent"
            style="@style/AhdArc.Accent"
            android:src="@drawable/ahd_indicator_arc_36" />
        <ImageView
            android:id="@+id/ahd_indicator_fill_warn"
            style="@style/AhdArc.Warn"
            android:src="@drawable/ahd_indicator_arc_36" />
        <ImageView
            android:id="@+id/ahd_indicator_ring_icon"
            style="@style/AhdIcon.Accent"
            android:layout_width="16dp"
            android:layout_height="16dp"
            android:layout_gravity="center" />
    </FrameLayout>

    <LinearLayout
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_weight="1"
        android:orientation="vertical">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal">

            <ImageView
                android:id="@+id/ahd_indicator_icon"
                style="@style/AhdIcon.Accent"
                android:layout_width="18dp"
                android:layout_height="18dp"
                android:layout_gravity="center_vertical"
                android:layout_marginEnd="5dp"
                android:visibility="gone" />
            <TextView
                android:id="@+id/ahd_indicator_value"
                style="@style/AhdValue"
                android:textSize="@dimen/ahd_indicator_value_text"
                android:visibility="gone" />
            <TextView
                android:id="@+id/ahd_indicator_value_warn"
                style="@style/AhdValue.Warn"
                android:textSize="@dimen/ahd_indicator_value_text"
                android:visibility="gone" />
            <TextView
                android:id="@+id/ahd_indicator_value_none"
                style="@style/AhdValue.Muted"
                android:textSize="@dimen/ahd_indicator_value_text"
                android:visibility="gone" />
            <TextView
                android:id="@+id/ahd_indicator_max"
                style="@style/AhdText.Muted"
                android:layout_marginStart="1dp"
                android:ellipsize="none"
                android:textSize="@dimen/ahd_indicator_small_text"
                android:visibility="gone" />
        </LinearLayout>

        <LinearLayout
            android:id="@+id/ahd_indicator_pips"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:orientation="horizontal"
            android:visibility="gone">
            <ImageView
                android:id="@+id/ahd_indicator_pip_1"
                style="@style/AhdPip" />
            <ImageView
                android:id="@+id/ahd_indicator_pip_2"
                style="@style/AhdPip" />
            <ImageView
                android:id="@+id/ahd_indicator_pip_3"
                style="@style/AhdPip" />
            <ImageView
                android:id="@+id/ahd_indicator_pip_4"
                style="@style/AhdPip" />
            <ImageView
                android:id="@+id/ahd_indicator_pip_5"
                style="@style/AhdPip" />
        </LinearLayout>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <ImageView
                android:id="@+id/ahd_indicator_gift"
                style="@style/AhdIcon.Muted"
                android:layout_width="13dp"
                android:layout_height="13dp"
                android:layout_marginEnd="3dp"
                android:src="@drawable/ahd_indicator_icon_gift"
                android:visibility="gone" />
            <ImageView
                android:id="@+id/ahd_indicator_detail_icon_muted"
                style="@style/AhdDetailIcon.Muted" />
            <ImageView
                android:id="@+id/ahd_indicator_detail_icon_warn"
                style="@style/AhdDetailIcon.Warn" />
            <ImageView
                android:id="@+id/ahd_indicator_detail_icon_done"
                style="@style/AhdDetailIcon.Done" />
            <TextView
                android:id="@+id/ahd_indicator_detail_muted"
                style="@style/AhdText.Muted"
                android:textSize="@dimen/ahd_indicator_small_text"
                android:visibility="gone" />
            <TextView
                android:id="@+id/ahd_indicator_detail_warn"
                style="@style/AhdText.Warn"
                android:textSize="@dimen/ahd_indicator_small_text"
                android:visibility="gone" />
            <TextView
                android:id="@+id/ahd_indicator_detail_done"
                style="@style/AhdText.Done"
                android:textSize="@dimen/ahd_indicator_small_text"
                android:visibility="gone" />
        </LinearLayout>
    </LinearLayout>
</LinearLayout>
