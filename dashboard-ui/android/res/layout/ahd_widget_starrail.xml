<?xml version="1.0" encoding="utf-8"?>
<!-- Honkai: Star Rail 3x3 widget, regular (kotlin/StarRailWidget.kt, StarRailWidgetLayout.REGULAR;
     narrow widgets and large fonts use ahd_widget_starrail_compact.xml). Header: game. Top row:
     the Trailblaze Power arc, with "全回復まで" and the time to full (bolt icon), the reserve and
     the fetch time beside it.
     Below: full-width bars for assignments, daily training and Simulated Universe points (full
     width so values are not clipped at the 180dp minimum or at large font sizes). The
     indicator slots are filled from code (AhdIndicators). Without data only the header and the
     message box (icon, what to do, tap hint) show; this is also the picker preview (with the
     description) and the initial layout. Lines that can warn exist twice (name / name_full) so
     their colors follow dark mode. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/ahd_widget_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/ahd_widget_starrail_background"
    android:orientation="vertical"
    android:padding="12dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <ImageView
            android:layout_width="16dp"
            android:layout_height="16dp"
            android:layout_marginEnd="6dp"
            android:importantForAccessibility="no"
            android:src="@drawable/ahd_widget_starrail_icon"
            android:tint="@color/ahd_indicator_starrail"
            android:tintMode="src_in" />

        <TextView
            android:id="@+id/ahd_widget_title"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:ellipsize="end"
            android:includeFontPadding="false"
            android:maxLines="1"
            android:text="@string/ahd_widget_starrail_label"
            android:textColor="@color/ahd_indicator_starrail"
            android:textSize="14sp"
            android:textStyle="bold" />
    </LinearLayout>

    <LinearLayout
        android:id="@+id/ahd_widget_content"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:gravity="center_vertical"
        android:orientation="vertical"
        android:visibility="gone">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <FrameLayout
                android:id="@+id/ahd_widget_power"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content" />

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="12dp"
                android:layout_weight="1"
                android:orientation="vertical">

                <!-- The bolt stands for the Trailblaze Power label (spoken through the arc's
                     description). The time has the column's width to itself; StarRailWidgetLayout
                     switches to the compact layout before it would be ellipsized. -->
                <TextView
                    android:id="@+id/ahd_widget_power_until"
                    style="@style/AhdWidgetStarRailLine"
                    android:layout_marginTop="0dp"
                    android:text="@string/ahd_widget_until_full" />

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:gravity="center_vertical"
                    android:orientation="horizontal">

                    <ImageView
                        style="@style/AhdWidgetStarRailRowIcon"
                        android:layout_marginEnd="4dp"
                        android:src="@drawable/ahd_indicator_icon_power" />

                    <TextView
                        android:id="@+id/ahd_widget_power_time"
                        android:layout_width="0dp"
                        android:layout_weight="1"
                        style="@style/AhdWidgetStarRailTime" />

                    <TextView
                        android:id="@+id/ahd_widget_power_time_full"
                        android:layout_width="0dp"
                        android:layout_weight="1"
                        style="@style/AhdWidgetStarRailTime.Warn" />
                </LinearLayout>

                <TextView
                    android:id="@+id/ahd_widget_reserve"
                    style="@style/AhdWidgetStarRailLine" />

                <TextView
                    android:id="@+id/ahd_widget_reserve_full"
                    style="@style/AhdWidgetStarRailLine.Warn" />

                <TextView
                    android:id="@+id/ahd_widget_updated"
                    style="@style/AhdWidgetStarRailSmall" />

                <TextView
                    android:id="@+id/ahd_widget_updated_full"
                    style="@style/AhdWidgetStarRailSmall.Warn" />
            </LinearLayout>
        </LinearLayout>

        <LinearLayout
            style="@style/AhdWidgetStarRailRow"
            android:layout_marginTop="6dp">
            <ImageView
                style="@style/AhdWidgetStarRailRowIcon"
                android:src="@drawable/ahd_indicator_icon_expedition" />
            <FrameLayout
                android:id="@+id/ahd_widget_assignments"
                style="@style/AhdWidgetStarRailSlot" />
        </LinearLayout>

        <LinearLayout
            style="@style/AhdWidgetStarRailRow"
            android:layout_marginTop="3dp">
            <ImageView
                style="@style/AhdWidgetStarRailRowIcon"
                android:src="@drawable/ahd_indicator_icon_daily" />
            <FrameLayout
                android:id="@+id/ahd_widget_daily"
                style="@style/AhdWidgetStarRailSlot" />
        </LinearLayout>

        <LinearLayout
            style="@style/AhdWidgetStarRailRow"
            android:layout_marginTop="3dp">
            <ImageView
                style="@style/AhdWidgetStarRailRowIcon"
                android:src="@drawable/ahd_widget_starrail_icon_weekly" />
            <FrameLayout
                android:id="@+id/ahd_widget_weekly"
                style="@style/AhdWidgetStarRailSlot" />
        </LinearLayout>
    </LinearLayout>

    <!-- Not signed in, no account or no status yet: what to do in the app (the preview shows
         the description), like the Genshin widget. -->
    <LinearLayout
        android:id="@+id/ahd_widget_message_box"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:gravity="center"
        android:orientation="vertical">

        <ImageView
            android:layout_width="36dp"
            android:layout_height="36dp"
            android:importantForAccessibility="no"
            android:src="@drawable/ahd_widget_starrail_icon"
            android:tint="@color/ahd_indicator_starrail"
            android:tintMode="src_in" />

        <TextView
            android:id="@+id/ahd_widget_status"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:ellipsize="end"
            android:gravity="center"
            android:maxLines="4"
            android:text="@string/ahd_widget_starrail_description"
            android:textColor="@color/ahd_indicator_text"
            android:textSize="13sp" />

        <TextView
            android:id="@+id/ahd_widget_hint"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:ellipsize="end"
            android:includeFontPadding="false"
            android:maxLines="1"
            android:text="@string/ahd_widget_open_hint"
            android:textColor="@color/ahd_widget_starrail_muted"
            android:textSize="11sp"
            android:visibility="gone" />
    </LinearLayout>
</LinearLayout>
