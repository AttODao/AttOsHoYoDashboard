<?xml version="1.0" encoding="utf-8"?>
<!-- ahd_indicator_tile.xml in the colors of the Genshin widget (AhdIndicators.tile adds it into a slot of
     the widget; a layout added from code does not inherit the widget root's theme overlay). -->
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:theme="@style/AhdGameGenshin">

    <include layout="@layout/ahd_indicator_tile" />
</FrameLayout>
