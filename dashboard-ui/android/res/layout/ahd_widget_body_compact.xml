<?xml version="1.0" encoding="utf-8"?>
<!-- Body of both compact widgets (included by ahd_widget_*_compact.xml; AhdWidgetLayout.COMPACT:
     resized below the regular size, or large text): the parts of ahd_widget_body.xml with a
     60dp arc, and the other values as one-line rows (AhdIndicators.tile with compact = true
     adds ahd_indicator_row.xml into the slots). Near the cap the warning symbol stands alone
     after the clock time (the words are spoken); at the cap the badge says it. The clock time
     takes the rest of its line and shrinks instead of being cut ("Tomorrow 2:48 AM"). -->
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="0dp"
    android:layout_weight="1"
    android:importantForAccessibility="noHideDescendants">

    <LinearLayout
        android:id="@+id/ahd_widget_message_box"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:gravity="center"
        android:orientation="vertical">

        <ImageView
            android:id="@+id/ahd_widget_message_icon"
            style="@style/AhdIcon.Muted"
            android:layout_width="28dp"
            android:layout_height="28dp"
            android:layout_marginBottom="8dp"
            android:visibility="gone" />

        <TextView
            android:id="@+id/ahd_widget_status"
            style="@style/AhdText"
            android:ellipsize="end"
            android:gravity="center"
            android:maxLines="4"
            android:text="@string/ahd_widget_loading"
            android:textSize="@dimen/ahd_widget_message_text" />

        <TextView
            android:id="@+id/ahd_widget_hint"
            style="@style/AhdText.Muted"
            android:layout_marginTop="6dp"
            android:visibility="gone" />
    </LinearLayout>

    <LinearLayout
        android:id="@+id/ahd_widget_content"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical"
        android:paddingTop="2dp"
        android:visibility="gone">

        <FrameLayout
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <FrameLayout
                android:layout_width="@dimen/ahd_widget_main_arc_compact"
                android:layout_height="63dp">

                <FrameLayout
                    android:layout_width="@dimen/ahd_widget_main_arc_compact"
                    android:layout_height="@dimen/ahd_widget_main_arc_compact">

                    <ImageView
                        style="@style/AhdArc.Track"
                        android:src="@drawable/ahd_indicator_arc_track_60" />
                    <ImageView
                        android:id="@+id/ahd_widget_main_fill_accent"
                        style="@style/AhdArc.Accent"
                        android:src="@drawable/ahd_indicator_arc_60" />
                    <ImageView
                        android:id="@+id/ahd_widget_main_fill_warn"
                        style="@style/AhdArc.Warn"
                        android:src="@drawable/ahd_indicator_arc_60" />

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        android:gravity="center"
                        android:orientation="vertical"
                        android:paddingBottom="6dp">

                        <ImageView
                            android:id="@+id/ahd_widget_main_icon"
                            style="@style/AhdIcon.Accent"
                            android:layout_width="14dp"
                            android:layout_height="14dp" />
                        <TextView
                            android:id="@+id/ahd_widget_main_value_accent"
                            style="@style/AhdArcValueCompact.Accent" />
                        <TextView
                            android:id="@+id/ahd_widget_main_value_warn"
                            style="@style/AhdArcValueCompact.Warn" />
                        <TextView
                            android:id="@+id/ahd_widget_main_value_none"
                            style="@style/AhdArcValueCompact.Muted" />
                    </LinearLayout>
                </FrameLayout>

                <TextView
                    android:id="@+id/ahd_widget_main_max"
                    style="@style/AhdArcMax.Compact" />
            </FrameLayout>

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="8dp"
                android:layout_weight="1"
                android:orientation="vertical">

                <LinearLayout
                    android:id="@+id/ahd_widget_main_badge"
                    style="@style/AhdBadge"
                    android:visibility="gone">
                    <ImageView style="@style/AhdBadgeIcon" />
                    <TextView
                        android:id="@+id/ahd_widget_main_badge_text"
                        style="@style/AhdText.Warn"
                        android:layout_marginStart="3dp" />
                </LinearLayout>

                <LinearLayout
                    android:id="@+id/ahd_widget_main_time_row"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:gravity="center_vertical"
                    android:orientation="horizontal"
                    android:visibility="gone">
                    <ImageView
                        style="@style/AhdIcon.Muted"
                        android:layout_width="13dp"
                        android:layout_height="13dp"
                        android:layout_marginEnd="4dp"
                        android:src="@drawable/ahd_indicator_icon_hourglass" />
                    <TextView
                        android:id="@+id/ahd_widget_main_time"
                        style="@style/AhdMainTime.Compact" />
                </LinearLayout>

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="3dp"
                    android:gravity="center_vertical"
                    android:orientation="horizontal">
                    <TextView
                        android:id="@+id/ahd_widget_main_clock"
                        style="@style/AhdMainClock"
                        android:layout_marginEnd="5dp"
                        android:visibility="gone" />
                    <LinearLayout
                        android:id="@+id/ahd_widget_main_near"
                        style="@style/AhdBadge"
                        android:paddingStart="4dp"
                        android:paddingTop="2dp"
                        android:paddingEnd="4dp"
                        android:paddingBottom="2dp"
                        android:visibility="gone">
                        <ImageView style="@style/AhdBadgeIcon" />
                    </LinearLayout>
                </LinearLayout>

                <LinearLayout
                    android:id="@+id/ahd_widget_main_unknown"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:gravity="center_vertical"
                    android:orientation="horizontal"
                    android:visibility="gone">
                    <ImageView
                        style="@style/AhdIcon.Muted"
                        android:layout_width="14dp"
                        android:layout_height="14dp"
                        android:layout_marginEnd="3dp"
                        android:src="@drawable/ahd_indicator_icon_unknown" />
                    <TextView
                        android:id="@+id/ahd_widget_main_time_none"
                        style="@style/AhdText.Muted" />
                </LinearLayout>
            </LinearLayout>
        </LinearLayout>

        <FrameLayout
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1" />

        <FrameLayout
            android:id="@+id/ahd_widget_slot_1"
            android:layout_width="match_parent"
            android:layout_height="wrap_content" />

        <FrameLayout
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1" />

        <FrameLayout
            android:id="@+id/ahd_widget_slot_2"
            android:layout_width="match_parent"
            android:layout_height="wrap_content" />

        <FrameLayout
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1" />

        <FrameLayout
            android:id="@+id/ahd_widget_slot_3"
            android:layout_width="match_parent"
            android:layout_height="wrap_content" />

        <FrameLayout
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1" />

        <FrameLayout
            android:id="@+id/ahd_widget_slot_4"
            android:layout_width="match_parent"
            android:layout_height="wrap_content" />

        <FrameLayout
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1" />
    </LinearLayout>
</FrameLayout>
