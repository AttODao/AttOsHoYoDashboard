<?xml version="1.0" encoding="utf-8"?>
<!-- Genshin widget, regular (GenshinWidgetLayout.REGULAR; also the initial layout). The panel in the dashboard's
     card colors of the game, whose theme overlay gives the shared header and body their game
     color, mark and name. Drawn by AhdWidgetFrame.kt; until the first update it shows the
     text of the body's message box. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/ahd_widget_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/ahd_widget_genshin_background"
    android:contentDescription="@string/ahd_widget_loading"
    android:orientation="vertical"
    android:padding="@dimen/ahd_widget_padding"
    android:theme="@style/AhdGameGenshin">

    <include layout="@layout/ahd_widget_header" />

    <include layout="@layout/ahd_widget_body" />
</LinearLayout>
