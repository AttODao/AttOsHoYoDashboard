<?xml version="1.0" encoding="utf-8"?>
<!-- Android 12 and newer (android:dataExtractionRules): the same exclusions as
     ahd_backup_rules.xml for cloud backups and device-to-device transfers. -->
<data-extraction-rules>
    <cloud-backup>
        <exclude domain="file" path="session-cookies.enc" />
        <exclude domain="file" path=".session-cookies.enc.tmp" />
        <exclude domain="file" path="session-cookies.json" />
        <exclude domain="file" path=".session-cookies.json.tmp" />
        <exclude domain="sharedpref" path="ahd_push.xml" />
    </cloud-backup>
    <device-transfer>
        <exclude domain="file" path="session-cookies.enc" />
        <exclude domain="file" path=".session-cookies.enc.tmp" />
        <exclude domain="file" path="session-cookies.json" />
        <exclude domain="file" path=".session-cookies.json.tmp" />
        <exclude domain="sharedpref" path="ahd_push.xml" />
    </device-transfer>
</data-extraction-rules>
