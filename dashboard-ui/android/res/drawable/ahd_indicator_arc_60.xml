<?xml version="1.0" encoding="utf-8"?>
<!-- Fill of the 60dp arc (the main resource, compact), 6dp wide. The drawable level is the sweep:
     7500 is the whole 270° (AhdIndicatorModel.ARC_LEVEL). The ring starts at the lower left
     (a ring's sweep follows the level; the radii are ratios of the width). Its ends are round
     like the track's: one dot on the start and one that the same level turns to the end.
     White, tinted by the layout (AhdArc.Accent / AhdArc.Warn). -->
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <item>
        <rotate
            android:fromDegrees="135"
            android:pivotX="50%"
            android:pivotY="50%"
            android:toDegrees="135">
            <shape
                android:innerRadiusRatio="2.5"
                android:shape="ring"
                android:thicknessRatio="10"
                android:useLevel="true">
                <solid android:color="#FFFFFFFF" />
            </shape>
        </rotate>
    </item>
    <item>
        <vector
            android:width="60dp"
            android:height="60dp"
            android:viewportWidth="60"
            android:viewportHeight="60">
            <path
                android:fillColor="#FFFFFFFF"
                android:pathData="M7.908,49.092a3,3 0 1,0 6,0a3,3 0 1,0 -6,0Z" />
        </vector>
    </item>
    <item>
        <rotate
            android:fromDegrees="0"
            android:pivotX="50%"
            android:pivotY="50%"
            android:toDegrees="360">
            <vector
                android:width="60dp"
                android:height="60dp"
                android:viewportWidth="60"
                android:viewportHeight="60">
                <path
                    android:fillColor="#FFFFFFFF"
                    android:pathData="M7.908,49.092a3,3 0 1,0 6,0a3,3 0 1,0 -6,0Z" />
            </vector>
        </rotate>
    </item>
</layer-list>
