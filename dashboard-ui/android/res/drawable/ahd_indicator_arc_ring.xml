<?xml version="1.0" encoding="utf-8"?>
<!-- A ring whose sweep is the drawable level (useLevel), turned so that it starts at the lower
     left; level 7500 is the whole 270° gauge (AhdIndicatorModel.ARC_LEVEL). The radii are
     ratios of the view width, so the ring scales with the view at every density. -->
<rotate xmlns:android="http://schemas.android.com/apk/res/android"
    android:fromDegrees="135"
    android:pivotX="50%"
    android:pivotY="50%"
    android:toDegrees="135">
    <shape
        android:innerRadiusRatio="2.7"
        android:shape="ring"
        android:thicknessRatio="10"
        android:useLevel="true">
        <solid android:color="#FFFFFFFF" />
    </shape>
</rotate>
