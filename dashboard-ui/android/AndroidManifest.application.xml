        <!-- AHD device notifications (dashboard-ui/android/MainActivity.kt) -->
        <receiver android:name="dev.dioxus.main.AhdAlarmReceiver" android:exported="false" />
        <receiver android:name="dev.dioxus.main.AhdBootReceiver" android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.BOOT_COMPLETED" />
                <action android:name="android.intent.action.MY_PACKAGE_REPLACED" />
            </intent-filter>
        </receiver>
        <!-- Polls the server's notification inbox every 15 minutes (AhdInbox). -->
        <service android:name="dev.dioxus.main.AhdInboxJob" android:exported="false"
            android:permission="android.permission.BIND_JOB_SERVICE" />
